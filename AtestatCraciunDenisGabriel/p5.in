#include <iostream>
using namespace std;
void linie(int n, char c)
{
    if(n>0)
    {
        linie(n-1,c);
        cout<<c;
    }
}
void sus(int n, int r)
{
    if(r<=n)
    {
        linie(n-r,' ');
        linie(2*r-1,'*');
        cout<<endl;
        sus(n,r+1);
    }
}
void jos(int n, int r)
{
    if(r<=n)
    {
        jos(n,r+1);
        linie(n-r+1,' ');
        linie(2*r-1,'*');
        cout<<endl;
    }
}
int main()
{
    int n;
    cin>>n;
    sus(n,1);
    jos(n-1,1);
    return 0;
}

