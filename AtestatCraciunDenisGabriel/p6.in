#include <iostream>
using namespace std;
unsigned int pm2(int n, unsigned int p)
{
    if(p*2>n) return p;
    else return pm2(n,p*2);
}
void puteri2(int n)
{
    if(n>0)
    {
        unsigned int p=pm2(n,1);
        puteri2(n-p);
        cout<<p<<" ";
    }
}
int main()
{
    int n;
    cin>>n;
    puteri2(n);
    return 0;
}


